{
  "name": "@niq-ai/niq-worker",
  "version": "0.0.0",
  "description": "TypeScript SDK for authoring niq Workers that connect to a niq bus over HTTP (SSE + POST).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
